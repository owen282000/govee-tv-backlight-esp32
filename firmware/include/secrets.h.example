// Copy to secrets.h (git ignores it) and fill in your network.
// Without secrets.h the firmware runs without Wi-Fi and listens on serial only.
#define WIFI_SSID "your-network"
#define WIFI_PASS "your-password"
// Password for over-the-air updates at http://<ip>/update (user "ota").
// Leave it out to switch over-the-air updates off.
#define OTA_PASS "choose-a-password"
